---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import KitOffer from "@components/escape-room/KitOffer.astro";
import ThemedSection from "@components/ThemedSection.astro";
import { getOpenGraphImageData } from "@lib/og-image";
import components from "@lib/mdx";
import type { Breadcrumbs, PageMetadata } from "@lib/types";
import kitDetails from "src/content/escape-room/kit-details.json";
import EscapeRoomLayout from "src/layouts/EscapeRoomLayout.astro";

export async function getStaticPaths() {
  const rooms = await getCollection("escapeRoomThemes");
  return rooms.map(room => ({ params: { id: room.id }, props: { room } }));
}

interface Props {
  room: CollectionEntry<"escapeRoomThemes">;
}

const { room } = Astro.props;
const { about, title, tagline, image, alt, page: { theme } } = room.data;
const { Content } = await render(room);
const roomsUrl = "/escape-room/themes/";
const crumbs: Breadcrumbs = [
  { name: "Home", href: "/escape-room/" },
  { name: "Build-Your-Own Rooms", href: roomsUrl },
];
const metadata: PageMetadata = {
  title,
  description: tagline,
  image: getOpenGraphImageData(Astro.site, "pages", "escape-room"),
};
const readyMadeByRoom: Record<string, { price: number; availability?: string } | undefined> = kitDetails.readyMade;
const readyMade = readyMadeByRoom[room.id];
const themeText = `text-${theme}-emphasis`;
const purchaseLink = (kit: string) =>
  `mailto:${kitDetails.contactEmail}?subject=${encodeURIComponent(`${title} — ${kit}`)}`;
---

<EscapeRoomLayout {metadata} {crumbs} {title}>
  <ThemedSection>
    <a class="icon-link mb-4" href={roomsUrl}>
      <span aria-hidden="true">←</span>
      All escape rooms
    </a>
    <div class="room-overview">
      <h1 class:list={[themeText, "mb-0"]}>{title}</h1>
      <Image
        src={image}
        alt={alt ?? ""}
        widths={[360, 540, 720, 1080, 1440]}
        sizes="(min-width: 1400px) 630px, (min-width: 992px) 45vw, 95vw"
        class="room-image rounded-3"
        loading="eager"
      />
      <div class="room-details">
        <p class="lead">{tagline}</p>
        <div class="d-flex flex-wrap column-gap-4 row-gap-2 mb-4">
          {about.players && <span><Icon name="bi:people-fill" aria-hidden="true" /> {about.players} players</span>}
          {about.length && <span><Icon name="bi:stopwatch-fill" aria-hidden="true" /> About {about.length} play time</span>}
        </div>
        <h2 class="h5 mb-3">Choose how you’d like it</h2>
        <div class="d-grid gap-3">
          <KitOffer
            title="Build-your-own kit"
            price={kitDetails.buildYourOwnPrice}
            href={purchaseLink("Build-your-own kit")}
            linkText="Email us to buy the build-your-own kit"
            {theme}
            featured
          >
            Includes instructions and lifetime access to the digital files. Building materials are sold separately{about.estimatedMaterialCost ? ` and cost approximately $${about.estimatedMaterialCost}` : ""}.
          </KitOffer>
          <KitOffer
            title="Ready-made kit"
            price={readyMade?.price}
            availability={readyMade?.availability}
            href={purchaseLink("Ready-made kit")}
            linkText="Email us about the ready-made kit"
            {theme}
          >
            We build and test the kit, then ship it assembled with all materials included.
          </KitOffer>
        </div>
      </div>
    </div>
  </ThemedSection>

  <ThemedSection {theme} styling="subtle" text>
    <Content {components} />
  </ThemedSection>

  <ThemedSection>
    <h2 class={themeText}>Included Assets</h2>
    <p class="bg-body-tertiary border-start border-2 px-3 py-3">
      <strong>Buying the ready-made kit?</strong>
      The shopping, building, and printing are already done. Everything else below still comes with your kit.
    </p>
    <dl class="mb-0">
      {kitDetails.includedAssets.map(asset => (
        <div class="border-bottom py-3">
          <dt>{asset.title}</dt>
          <dd class="mb-0">{asset.description}</dd>
        </div>
      ))}
    </dl>
  </ThemedSection>
</EscapeRoomLayout>

<style>
  .room-overview {
    display: grid;
    gap: 1.25rem;
  }

  .room-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (min-width: 992px) {
    .room-overview {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      grid-template-rows: auto 1fr;
      column-gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }

    h1 {
      grid-column: 2;
    }

    .room-image {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .room-details {
      grid-column: 2;
    }
  }
</style>
