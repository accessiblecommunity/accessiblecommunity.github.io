---
import { getOpenGraphImageData } from "@lib/og-image";
import type { Breadcrumbs, PageMetadata } from "@lib/types";

const title = "How it Works";
const metadata: PageMetadata = {
  title,
  description: "Questions about the Accessible Escape Room",
  image: getOpenGraphImageData(Astro.site, "pages", "escape-room"),
};
const crumbs: Breadcrumbs = [
  {
    name: "Home",
    href: "/escape-room/",
  },
];

const quotes = [
  "The puzzles were no joke! It was a perfect mix of frustrating and fun. I walked away feeling like I learned something, not just about the activity, but about myself.",
  "I didn't expect to enjoy it as much as I did. It was genuiniely fun and I loved how much it made us think through problems.",
  "I was surprised by how much I relied on my teammates. It reminded me that collaboration is such a huge part of problem-solving in our training and working with others every day.",
]

import Branding from "@components/Branding.astro";
import EscapeRoomLayout from "src/layouts/EscapeRoomLayout.astro";
import Hero from "@components/Hero.astro";
import { Icon } from "astro-icon/components";
import Row from "@components/Row.astro";
import ThemedSection from "@components/ThemedSection.astro";

import faqs from "src/content/escape-room-faq.json";
import heroBg from "src/images/escape-room/shaded/puzzle-display.jpg";
---

<EscapeRoomLayout {metadata} {title}>
  <Hero slot="header" theme="info" shade image={heroBg} imageVertical="0%" columns="col-8 col-md-5" {crumbs} {title}>
    <h1 class="display-2 px-1 bg-info bg-opacity-75" set:text={title} />
  </Hero>

  <ThemedSection>
    <h2 class="text-info">Overview</h2>
    <p class="lead">
      We believe that team-building activities should be available to everyone. We've created
      the <Branding>Accessible Escape Room</Branding> to ensure that everyone can take part.
    </p>
    <p>
      Each escape room kit is designed so that individuals with disabilities can complete at
      least one puzzle as a part of a group and participate in others. Each kit is also designed
      to be flexable and portable, so that they can be packed up easily and transported where
      they are needed.
    </p>
    <p>
      We've built and playtested each accessible escape room. Then, we document the process so
      that everything you need to purchase and assemble it is included. This allows you to pay
      less and customize the experience.
    </p>
  </ThemedSection>

  <ThemedSection styling="subtle" theme="secondary">
    <h2 class="text-center text-info mb-4">Quotes from our Customers</h2>
    <Row baseRowCols="1" lgRowCols="3" g="3" class="align-items-stretch align-items-lg-center">
      {
        quotes.map(q => (
          <div class="col">
            <div class="card border border-2 border-info">
              <div class="card-body">
                <p class="card-text">
                  <sup aria-hidden="true"><Icon name="quote-left" />&nbsp;</sup><span
                  set:text={q} /><sup aria-hidden="true">&nbsp;<Icon name="quote-right" /></sup>
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </Row>
  </ThemedSection>

  <ThemedSection styling="tertiary" id="faq">
    <h2 class="text-info">Frequently Asked Questions</h2>
    {faqs.map(({ question, answer, items, closing }, index) => (
      <details class="faq-item" name="escape-room-faq" open={index === 0}>
        <summary>
          <span>{question}</span>
          <span class="faq-indicator" aria-hidden="true"></span>
        </summary>
        <div class="faq-answer">
          {answer.map(part => {
            if (typeof part === "string") return part;
            if (part.brand) return <Branding class="text-primary" text={part.brand} />;
            return <a class="link-truncate" href={`mailto:${part.email}`}>{part.email}</a>;
          })}
          {items && <ul>{items.map(item => <li>{item}</li>)}</ul>}
          {closing}
        </div>
      </details>
    ))}
  </ThemedSection>
</EscapeRoomLayout>

<style>
  h1 {
    font-weight: 500;
  }
  [data-icon="quote-left"],
  [data-icon="quote-right"] {
    color: var(--bs-info);
    height: 0.7em;
  }

  .faq-item {
    background-color: var(--bs-body-bg);
    border: 1px solid var(--bs-border-color);
    border-radius: var(--bs-border-radius-lg);
  }

  .faq-item + .faq-item {
    margin-block-start: 0.5rem;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-radius: inherit;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .faq-indicator {
    flex: none;
    display: grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
  }

  .faq-indicator::before,
  .faq-indicator::after {
    content: "";
    grid-area: 1 / 1;
    width: 0.75rem;
    border-block-start: 2px solid currentColor;
  }

  .faq-indicator::after {
    transform: rotate(90deg);
  }

  details[open] .faq-indicator::after {
    display: none;
  }

  .faq-answer {
    padding: 0 1rem 1rem;
  }

  .faq-answer > ul:last-child {
    margin-block-end: 0;
  }
</style>
