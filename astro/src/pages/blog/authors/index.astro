---
import { formatAuthorName, getBlogAuthors } from "../../../lib/blog";
import type { Breadcrumbs, PageMetadata } from "../../../lib/types";

const authors = await getBlogAuthors();
const title = "Blogs: Authors";
const metadata: PageMetadata = {
  title,
  description: "A listing of all of the blog authors",
};
const crumbs: Breadcrumbs = [
  {
    name: "Home",
    href: "/",
  },
  {
    name: "Blog",
    href: "/blog",
  },
];

import ImageHeading from "../../../components/ImageHeading.astro";
import Layout from "../../../layouts/Layout.astro";
import ThemedSection from "../../../components/ThemedSection.astro";
---

<Layout {crumbs} {title} {metadata}>
  <ImageHeading image="blog" slot="header">
    Blogs: <strong>Authors</strong>
  </ImageHeading>
  <ThemedSection styling="tertiary">
    <h2 class="text-info-emphasis display-5" set:text={title} />
    <ul>
      {
        authors.map((author) => (
          <li>
            <a href={`/blog/authors/${author.id}`}>{formatAuthorName(author)}</a>
          </li>
        ))
      }
    </ul>
  </ThemedSection>
</Layout>
