---
interface Props {
  title: string;
  price?: number;
  availability?: string;
  href: string;
  linkText: string;
  theme: string;
  featured?: boolean;
}

const { title, price, availability, href, linkText, theme, featured = false } = Astro.props;
const outlineColor = `var(--bs-${theme}-text-emphasis)`;
const currency = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
---

<div class:list={["card border-2 rounded-3", `border-${theme}-subtle`]}>
  <div class="card-body p-3 p-sm-4">
    <h3 class:list={["h5 card-title mb-3", `text-${theme}-emphasis`]}>{title}</h3>
    <p class="h2 fw-bold mb-3">{price === undefined ? "Contact us for pricing" : currency.format(price)}</p>
    <p><slot /></p>
    {availability && <p>{availability}</p>}
    <a class:list={["btn d-block mt-3", featured ? `btn-${theme}` : `btn-outline-${theme} kit-offer-outline`]} {href}>
      {linkText}
    </a>
  </div>
</div>

<style define:vars={{ outlineColor }}>
  .kit-offer-outline {
    --bs-btn-color: var(--outlineColor);
    --bs-btn-border-color: var(--outlineColor);
  }
</style>
